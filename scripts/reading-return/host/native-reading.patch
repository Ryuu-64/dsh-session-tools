@@ -0,0 +1,102 @@
+/** Window-local reading bookmarks and the native Chat owner's restoration capability. */
+import type { Branded } from '@deepseek-ai/dsh-brand'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Opaque identity issued by one mounted browser's reading service. */
+export type ChatReadingBookmarkId = Branded<'ChatReadingBookmarkId'>
+
+/** A transient bookmark; copying or serializing it does not preserve its authority. */
+export interface ChatReadingBookmark {
+  readonly id: ChatReadingBookmarkId
+  readonly sessionId: SessionId
+  /** Main Session selected while the original occurrence is revealed; null for a fixed standalone embedding. */
+  readonly navigationSessionId: SessionId | null
+}
+
+/** Exact completion or the reason no precise restoration was committed. */
+export type ChatReadingRestoreResult =
+  | { readonly kind: 'restored'; readonly exactOffset: boolean }
+  | { readonly kind: 'unavailable' | 'missing' | 'changed' | 'interrupted' }
+
+/** Stable native embedding lifetime and its source-directed navigation. */
+export interface ChatReadingRoute {
+  /** Main Session hosting this embedding. */
+  readonly mainSessionId: SessionId
+  /** Identity and lifetime of the actual embedding, independent of renderer mounts. */
+  readonly signal: AbortSignal
+  /** Whether revealing this occurrence requires changing the main Session. */
+  needsMainNavigation(): boolean
+  /**
+   * Reveal the existing occurrence without creating or substituting a tab.
+   * Any main navigation is initiated synchronously before the first await.
+   * @param sessionId - captured source Session.
+   * @param signal - restoration cancellation.
+   * @returns false after closure, replacement or incompatible navigation.
+   */
+  open(sessionId: SessionId, signal: AbortSignal): Promise<boolean>
+}
+
+/** Public browser service; native owners retain geometry, follow policy and instance state. */
+export interface UiChatReading {
+  /**
+   * Bind a native embedding's current DOM root to its stable navigation lifetime.
+   * @param element - embedding root supplied by its owning component.
+   * @param route - owner-provided reveal/navigation capability.
+   * @returns detachment of this mount; the route signal alone retires the occurrence.
+   */
+  connectOccurrence(element: Element, route: ChatReadingRoute): () => void
+  /**
+   * Capture the reading occurrence containing a user-action origin.
+   * @param origin - initiating control; the service resolves its registered native owner.
+   * @returns an opaque window-local bookmark, or null without visible identifiable content.
+   */
+  capture(origin: Element): ChatReadingBookmark | null
+  /**
+   * Restore the original live occurrence and hold its content even at the tail.
+   * Native main and registered embedded occurrences navigate through their own owners.
+   * Only explicit reader navigation to latest releases the resulting hold.
+   * @param bookmark - unmodified bookmark returned by this service.
+   * @param signal - caller-owned bounded cancellation, including superseding navigation.
+   * @returns the precise completion status; loading failures reject for caller-owned retry UI.
+   */
+  restore(bookmark: ChatReadingBookmark, signal: AbortSignal): Promise<ChatReadingRestoreResult>
+}
+
+/** Native paragraph identity and offsets, owned by the Chat viewport. */
+export interface ChatReadingPosition {
+  readonly anchorKey: string
+  readonly nodeKey: string
+  readonly paragraph: number
+  readonly tag: string
+  readonly text: string
+  readonly top: number
+  readonly width: number
+  readonly height: number
+  readonly groups: readonly { readonly key: string; readonly top: number }[]
+}
+
+/** One native restoration transaction, distinct from a committed reading hold. */
+export interface NativeChatRestoreTransaction {
+  /** @returns the current native landing, without committing lasting ownership. */
+  step(): 'pending' | 'missing' | 'changed' | 'interrupted' | { readonly exactOffset: boolean }
+  /** @returns whether this still-current transaction committed its reading hold. */
+  commit(): boolean
+  /** Remove this transaction's temporary ownership; a committed or superseded transaction is unchanged. */
+  cancel(): void
+}
+
+/** Package-owned mounted-view callbacks; consumers only use UiChatReading. */
+export interface NativeChatReader {
+  readonly element: HTMLElement
+  /** @returns the actual visible native content position. */
+  capture(): ChatReadingPosition | null
+  /** @param position - semantic target. @param signal - operation cancellation. @returns one restoration transaction. */
+  begin(position: ChatReadingPosition, signal: AbortSignal): NativeChatRestoreTransaction
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Native occurrence-addressed Chat reading, local to this browser window. */
+    uiChatReading: UiChatReading
+  }
+}
