+      this.occurrences.set(owner, occurrence)
+    }
+    const mounted = { sessionId, reader }
+    const registered = occurrence
+    registered.mounted = mounted
+    this.readers.set(reader.element, registered)
+    return () => {
+      if (registered.mounted === mounted || registered.mounted?.reader.element !== reader.element) this.readers.delete(reader.element)
+      if (registered.mounted === mounted) {
+        registered.mounted = null
+        if (registered.restoringSession === sessionId) registered.operation?.abort()
+      }
+    }
+  }
