+    for (let element: Element | null = origin; element !== null; element = element.parentElement) {
+      occurrence = this.readers.get(element)
+      if (occurrence !== undefined) break
+    }
+    const mounted = occurrence?.mounted
+    if (occurrence === undefined || mounted == null || !occurrence.owner.isConnected || occurrence.route?.signal.aborted) return null
