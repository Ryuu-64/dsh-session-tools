@@ -0,0 +1,270 @@
+/** Resolves native reading occurrences without exposing their DOM, hooks or internal controllers. */
+import type { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import type {
+  ChatReadingBookmark, ChatReadingBookmarkId, ChatReadingPosition,
+  ChatReadingRestoreResult, ChatReadingRoute, NativeChatReader, NativeChatRestoreTransaction, UiChatReading,
+} from './contract/reading.ts'
+
+/** A source failure distinguished from transient loading errors by the consumer. */
+export class ReadingSourceError extends Error {
+  /** @param kind - absent session or semantic content. */
+  constructor(readonly kind: 'unavailable' | 'missing') { super(kind) }
+}
+
+interface Occurrence {
+  owner: Element
+  route?: ChatReadingRoute
+  readonly main: boolean
+  mounted: { readonly sessionId: SessionId; readonly reader: NativeChatReader } | null
+  operation: AbortController | null
+  restoringSession: SessionId | null
+}
+
+interface SavedReading {
+  readonly occurrence: Occurrence
+  readonly position: ChatReadingPosition
+  readonly reader: NativeChatReader
+  readonly route: ChatReadingRoute | null
+  readonly seq: SessionSeq
+}
+
+/** The service receives native host operations from its apply-world owner. */
+export interface ReadingHost {
+  /** @param sessionId - source Session. @param nodeKey - semantic content. @returns its current sequence, if available. */
+  sequence(sessionId: SessionId, nodeKey: string): SessionSeq | undefined
+  /** @param sessionId - source Session. @param nodeKey - semantic content. @param seq - history bound. @param signal - cancellation. @returns the temporary reference release. */
+  prepare(sessionId: SessionId, nodeKey: string, seq: SessionSeq, signal: AbortSignal): Promise<() => void>
+  /** @param sessionId - existing Session to select in the main reading occurrence. */
+  open(sessionId: SessionId): void
+  /** @returns the signal of a newly owned main-navigation operation. */
+  beginNavigation(): AbortSignal
+}
+
+/** One browser's registry of mounted Chat readers and ephemeral bookmarks. */
+export class ChatReadingService implements UiChatReading {
+  private occurrences = new WeakMap<Element, Occurrence>()
+  private readers = new WeakMap<Element, Occurrence>()
+  private routeRoots = new WeakMap<Element, Occurrence>()
+  private routes = new WeakMap<AbortSignal, Occurrence>()
+  private bookmarks = new WeakMap<ChatReadingBookmark, SavedReading>()
+  private readonly operations = new Set<AbortController>()
+  private readonly completions = new Set<Promise<void>>()
+  private disposed = false
+
+  /** @param host - session loading and main-navigation capabilities owned by the host. */
+  constructor(private readonly host: ReadingHost) {}
+
+  connectOccurrence(element: Element, route: ChatReadingRoute): () => void {
+    if (this.disposed || route.signal.aborted) return () => {}
+    let occurrence = this.routes.get(route.signal)
+    if (occurrence === undefined) {
+      occurrence = { owner: element, route, main: false, mounted: null, operation: null, restoringSession: null }
+      this.routes.set(route.signal, occurrence)
+    } else { occurrence.owner = element; occurrence.route = route }
+    this.routeRoots.set(element, occurrence)
+    return () => { this.routeRoots.delete(element) }
+  }
+
+  /**
+   * Register one native Chat mount under its actual containing reading occurrence.
+   * @param sessionId - session displayed by this mount.
+   * @param reader - native capture, restore and focus callbacks.
+   * @returns removal of this mount without retiring its still-mounted main container.
+   */
+  mount(sessionId: SessionId, reader: NativeChatReader): () => void {
+    let live = true
+    let release = (): void => {}
+    queueMicrotask(() => {
+      if (live && !this.disposed) release = this.mountNow(sessionId, reader)
+    })
+    return () => { live = false; release() }
+  }
+
+  private mountNow(sessionId: SessionId, reader: NativeChatReader): () => void {
+    const content = reader.element.closest('[data-conversation-content]') ?? reader.element
+    const mainSlot = content.closest('[data-slot="main.conversation"]')
+    const main = mainSlot?.querySelector('[data-conversation-content]') === content
+    const owner = main ? mainSlot?.closest('[data-slot="main"]') ?? content : content
