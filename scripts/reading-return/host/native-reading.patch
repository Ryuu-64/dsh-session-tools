+    if (position === null) return null
+    const seq = this.host.sequence(mounted.sessionId, position.nodeKey)
+    if (seq === undefined) return null
+    const bookmark = Object.freeze({
+      id: crypto.randomUUID() as ChatReadingBookmarkId, sessionId: mounted.sessionId,
+      navigationSessionId: occurrence.main ? mounted.sessionId : occurrence.route?.mainSessionId ?? null,
+    })
+    this.bookmarks.set(bookmark, { occurrence, position, seq, reader: mounted.reader, route: occurrence.route ?? null })
+    return bookmark
+  }
+
+  async restore(bookmark: ChatReadingBookmark, signal: AbortSignal): Promise<ChatReadingRestoreResult> {
+    const saved = this.bookmarks.get(bookmark)
+    if (this.disposed || saved === undefined) return { kind: 'unavailable' }
+    const available = (): boolean => saved.route === null ? saved.occurrence.owner.isConnected : !saved.route.signal.aborted
+    if (!available()) return { kind: 'unavailable' }
+    const { occurrence, position, seq } = saved
+    if (!occurrence.main && saved.route === null && (occurrence.mounted?.sessionId !== bookmark.sessionId
+      || occurrence.mounted.reader !== saved.reader)) return { kind: 'unavailable' }
